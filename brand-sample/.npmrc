# Supply-chain cooling-off period: only install versions published more than
# this many days ago. See ../frontend-plugin-sample/.npmrc for the reasoning.
#
# npm reads the project config only from the directory holding package.json and
# does not walk up, so each npm package in this repo needs its own copy.
#
# Requires npm >= 11.10.0. Note .nvmrc here still pins Node 20, which bundles
# npm 10.8.2 and ignores this setting -- so it has no effect until that moves
# to Node 24.
#
# Keep in sync with `minimumReleaseAge` in ../renovate.json5 and with
# `exclude-newer` in ../backend-plugin-sample/pyproject.toml.
min-release-age=7
